# ─────────────────────────────────────────────────────────────
# CoAdvisor — Variables d'environnement (Sprint 1)
# Copier ce fichier vers .env et ajuster les valeurs locales.
# ─────────────────────────────────────────────────────────────

# PostgreSQL — RÔLE APPLICATIF (NOBYPASSRLS) utilisé par le code au runtime.
# C'est ce rôle qui fait respecter l'isolation multi-tenant (RLS).
DATABASE_URL="postgresql://coadvisor_app:coadvisor_app_dev_password@localhost:5432/coadvisor"

# PostgreSQL — RÔLE PROPRIÉTAIRE utilisé UNIQUEMENT pour les migrations (DDL).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/coadvisor"

# Sessions (Sprint 1 — auth auto-hébergée)
SESSION_TTL_DAYS="7"

# ─────────────────────────────────────────────────────────────
# Copilot (Sprint 5 — Advisor Intelligence, ADR-008)
# Serveur SEULEMENT — ces valeurs ne doivent jamais rejoindre le
# navigateur (les appels partent des server actions Next.js).
# ─────────────────────────────────────────────────────────────

# Provider Copilot : "codex-bridge" (passerelle locale compatible
# OpenAI), "local-composer" (déterministe), ou "auto" (défaut :
# codex-bridge si LLM_BASE_URL est défini, sinon composer local).
COPILOT_PROVIDER="auto"

# Passerelle locale compatible OpenAI (tools/codex-bridge — voir son
# README). Laissez vide/absent pour utiliser le composer local.
LLM_BASE_URL="http://127.0.0.1:8787/v1"

# Clé LOCALE partagée avec la passerelle (BRIDGE_API_KEY côté bridge).
# Ce n'est PAS une clé API OpenAI — le bridge authentifie Codex via
# votre propre session `codex login` (ChatGPT Plus).
LLM_API_KEY="coadvisor-demo-secret"

# Modèle annoncé dans la requête chat.completions (la passerelle le
# retransmet au CLI Codex).
LLM_MODEL="gpt-5.6-terra"

# Délai maximum d'une génération Copilot (ms) avant secours local.
LLM_TIMEOUT_MS="60000"

# ─── Sprint 6 : Notifications e-mail (module @coadvisor/notifications) ───
# Provider actif : « auto » (défaut — Resend si RESEND_API_KEY défini,
# sinon journal local serveur : les e-mails sont tracés dans la console,
# rien ne part), « log » (forcer le journal) ou « resend ».
EMAIL_PROVIDER="auto"

# Resend (https://resend.com) — requis seulement si EMAIL_PROVIDER=resend
# (ou pour l'activer en mode auto). Aucune clé nécessaire en développement.
RESEND_API_KEY=""

# Expéditeur affiché des notifications (doit être validé chez Resend).
EMAIL_FROM="CoAdvisor <notifications@coadvisor.ca>"

# Délai maximum d'un appel au service d'e-mails (ms).
EMAIL_RESEND_TIMEOUT_MS="10000"

NODE_ENV="development"

# ─── Sprint 7 : Coffre documentaire (module @coadvisor/documents) ───
# Répertoire des blobs chiffrés. Relatif = ancré à la racine du monorepo
# (les 3 apps partagent le même coffre, peu importe leur CWD).
DOCUMENTS_STORAGE_DIR="./var/documents"

# Clé maîtresse AES-256 : 32 octets encodés en base64.
# Générer : openssl rand -base64 32
# (vide = stockage indisponible, bannière d'avertissement dans le Coffre)
DOCUMENTS_MASTER_KEY=""

# ─── Sprint 8 : SaaS Commercialization (ADR-013/014/015) ───
# Tenant opérateur plateforme (propriétaire des métriques MRR et de la
# console Sauvegardes). Démo locale : « cabinet-demo » (c'est le cabinet
# semé — sans ça la console Sauvegardes et la vue plateforme restent
# verrouillées « équipe fondatrice »). PRODUCTION : « twodots ».
PLATFORM_TENANT_SLUG="cabinet-demo"

# URL de la console conseiller (liens croisés depuis l'annuaire :3002).
WEB_ADVISOR_URL="http://localhost:3000"

# Sauvegardes : réplica locale toujours active + S3 quand configuré.
DOCUMENTS_REPLICA_DIR="./var/documents-replica"
BACKUP_MANIFESTS_DIR="./var/backups"

# Stripe — vides ⇒ simulateur local ; poser STRIPE_SECRET_KEY fait
# basculer le checkout vers le portail Stripe (webhook signé requis).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENTIEL=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_CABINET=""
STRIPE_PRICE_SEAT=""

# S3 compatible, région Canada (réplication des blobs CHIFFRÉS — la
# clé maîtresse ne quitte jamais le serveur). MinIO : endpoint +
# S3_FORCE_PATH_STYLE=true.
S3_REGION="ca-central-1"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="coadvisor-backups/"
S3_FORCE_PATH_STYLE="false"
